pipeline {
    agent {
        label 'docker'
    }

    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REGISTRY = '942548380129.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO     = 'roboshop/catalogue'
        IMAGE_TAG    = "${BUILD_NUMBER}"
        IMAGE_NAME   = "${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"
        LATEST_IMAGE = "${ECR_REGISTRY}/${ECR_REPO}:latest"
    }

    tools {
        nodejs 'nodejs'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    credentialsId: 'jenkins-github-ssh',
                    url: 'git@github.com:opttimusprime/catalogue.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('SonarQube Scan') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=catalogue \
                            -Dsonar.projectName=catalogue \
                            -Dsonar.sources=. \
                            -Dsonar.exclusions=node_modules/**,coverage/**
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                    docker build -t ${IMAGE_NAME} -t ${LATEST_IMAGE} .
                """
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    mkdir -p trivy-reports

                    curl -sL \
                      https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/html.tpl \
                      -o html.tpl

                    trivy image \
                      --format template \
                      --template "@html.tpl" \
                      -o trivy-reports/trivy-report.html \
                      ${IMAGE_NAME}

                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      --no-progress \
                      ${IMAGE_NAME}
                '''
            }
        }

        stage('Login to ECR') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${ECR_REGISTRY}
                """
            }
        }

        stage('Push Docker Image') {
            steps {
                sh """
                    docker push ${IMAGE_NAME}
                    docker push ${LATEST_IMAGE}
                """
            }
        }
    }

    post {
        always {
            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'trivy-reports',
                reportFiles: 'trivy-report.html',
                reportName: 'Trivy Security Report'
            ])

            sh """
                docker rmi ${IMAGE_NAME} ${LATEST_IMAGE} || true
            """
        }

        success {
            echo "Catalogue CI completed successfully"
            echo "Image pushed: ${IMAGE_NAME}"

            build job: 'catalogue-cd',
                parameters: [
                    string(name: 'IMAGE_TAG', value: "${env.IMAGE_TAG}"),
                    string(name: 'ENVIRONMENT', value: 'dev')
                ],
                wait: false
        }

        failure {
            echo 'Catalogue CI failed'
        }
    }
}